{#
  Morim Foundation landing page.

  Rendered once per language by build.py. `t` holds the strings from
  src/i18n/<lang>.json, `root` is "" for the English page at / and "../" for
  the pages at /ru/ and /he/, `langs` drives the language switcher.

  Ported from PR #3 (website/app/home-content.tsx, sections.tsx, hero.tsx,
  mobile-menu.tsx). Interactive widgets are native elements wired up by
  js/main.js; the hero is plain markup.

  The landing runs: the claim and the years (hero), the frame the programs
  stand on (three lines, three rows), this year's themes, the four steps,
  the Tbilisi pilot, the offers by audience, the stipend, the desk, the
  team, the FAQ.
#}
{# The footer's language list: every language by its own name, the current
   one marked. #}
{% macro switcher(class, tag='nav') -%}
<{{ tag }} class="lang-switcher {{ class }}"{% if tag != 'nav' %} role="group"{% endif %} aria-label="{{ t.switcher.label }}">
  {% for l in langs %}
  <a {{ lang_target(l) }}{% if l.current %} aria-current="page"{% endif %}{% if l.dir == 'rtl' %} dir="rtl"{% endif %}>{{ l.name }}</a>
  {% endfor %}
</{{ tag }}>
{%- endmacro %}

{# Where a switcher entry leads. A language not linked yet (build.py, LANGS)
   keeps its place but loses its href: greyed out, not focusable, announced
   as a disabled link. Its page still answers at its own URL. #}
{% macro lang_target(l) -%}
{% if l.linked %}href="{{ l.href }}" hreflang="{{ l.code }}"{% else %}role="link" aria-disabled="true"{% endif %} lang="{{ l.code }}"
{%- endmacro %}

{# Round flag icons for the language menu, drawn inline so no image ships.
   English is half Union Jack, half Stars and Stripes. #}
{% macro flag(code) -%}
<svg class="flag" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">{% if code == 'en' %}<rect width="24" height="24" fill="#012169"/><path d="M0 0 24 24M24 0 0 24" stroke="#fff" stroke-width="4.8"/><path d="M0 0 24 24M24 0 0 24" stroke="#c8102e" stroke-width="1.6"/><path d="M12 0v24M0 12h24" stroke="#fff" stroke-width="6"/><path d="M12 0v24M0 12h24" stroke="#c8102e" stroke-width="3.6"/><rect x="12" width="12" height="24" fill="#fff"/><rect x="12" y="0.000" width="12" height="1.846" fill="#b31942"/><rect x="12" y="3.692" width="12" height="1.846" fill="#b31942"/><rect x="12" y="7.385" width="12" height="1.846" fill="#b31942"/><rect x="12" y="11.077" width="12" height="1.846" fill="#b31942"/><rect x="12" y="14.769" width="12" height="1.846" fill="#b31942"/><rect x="12" y="18.462" width="12" height="1.846" fill="#b31942"/><rect x="12" y="22.154" width="12" height="1.846" fill="#b31942"/><rect x="12" width="6" height="12.923" fill="#0a3161"/><path d="M12 0v24" stroke="#fff" stroke-width="0.6"/>{% elif code == 'ru' %}<rect width="24" height="8" fill="#fff"/><rect y="8" width="24" height="8" fill="#0039a6"/><rect y="16" width="24" height="8" fill="#d52b1e"/>{% elif code == 'he' %}<rect width="24" height="24" fill="#fff"/><rect y="3" width="24" height="2.6" fill="#0038b8"/><rect y="18.4" width="24" height="2.6" fill="#0038b8"/><path d="M12 7.4 15.8 14H8.2ZM12 16.6 8.2 10H15.8Z" fill="none" stroke="#0038b8" stroke-width="1"/>{% endif %}</svg>
{%- endmacro %}

{# A disclosure menu in the header: a text button with a chevron opening a
   small card of links. Used for the languages; the caller supplies the <li>
   items. #}
{% macro nav_menu(id, label, class='', icon='', sr='') -%}
<div class="nav-menu {{ class }}">
  <button type="button" class="nav-menu-button" aria-haspopup="true" aria-expanded="false"
          aria-controls="{{ id }}-list">
    {{ icon }}{% if sr %}<span class="sr-only">{{ sr }}: </span>{% endif %}<span>{{ label }}</span>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <ul id="{{ id }}-list" class="nav-menu-list" hidden>
    {{ caller() }}
  </ul>
</div>
{%- endmacro %}

{# The button shows the current language as a flag and a short name; the
   list holds only the other two, each with its flag and full name. #}
{% macro lang_menu() -%}
{% set short = {'en': 'Eng', 'ru': 'Рус', 'he': 'עברית'} %}
{% call nav_menu('lang-menu', short[lang], 'lang-menu', flag(lang), t.switcher.label) %}
{% for l in langs if not l.current %}
<li><a {{ lang_target(l) }}{% if l.dir == 'rtl' %} dir="rtl"{% endif %}>{{ flag(l.code) }}<span>{{ l.name }}</span></a></li>
{% endfor %}
{% endcall %}
{%- endmacro %}

{% macro apply_button(class, label=none) -%}
<a class="{{ class }}" href="{{ t.links.survey }}" data-apply>{{ label or t.programs.apply }}</a>
{%- endmacro %}

{# The workshop scans (see README, "Photographs").

   `sizes` is not decoration here: above 701px the desktop layout is pure vw
   (base.css sets html{font-size:calc(100vw/90)}), so these boxes keep growing
   with the viewport and never settle at a fixed pixel size. Width descriptors
   let the browser weigh the box against the screen's pixel ratio; `2x`-style
   density descriptors cannot, and would go soft on a 4K panel.

   `width`/`height` are the layout box, not the file: the CSS crops with
   object-fit, so they stay put whatever candidate is chosen. #}
{% macro photo(class, stem, widths, sizes, alt, width, height, loading='lazy') -%}
<img class="{{ class }}" src="{{ root }}assets/{{ stem }}-{{ widths[1] }}.webp"
     srcset="{% for w in widths %}{{ root }}assets/{{ stem }}-{{ w }}.webp {{ w }}w{{ ", " if not loop.last }}{% endfor %}"
     sizes="{{ sizes }}"
     alt="{{ alt }}" width="{{ width }}" height="{{ height }}" loading="{{ loading }}"{{ ' fetchpriority="low"' if loading == 'eager' else '' }} decoding="async">
{%- endmacro %}

{# Measured in Chromium across 360-3840px: the mobile stop, then the vw the
   box settles at on desktop, rounded up so a candidate is never too small. #}
{% set landscape_widths = [480, 720, 1080, 1440, 2048] %}
{% set portrait_widths = [360, 500, 760, 1024, 1536] %}

{# `cost` is set per row, never page-wide: a stipend is money paid to the
   participant, and future children's clubs may be paid by parents, so each
   offer states its own terms. A row without a cost key stays unlabelled. #}
{% macro program_meta(where, when, cost=none, cost_plain=none) -%}
<p><span>{{ t.programs.where }}</span>{{ where }}</p>
<p><span>{{ t.programs.when }}</span>{{ when }}</p>
{% if cost %}<p class="program-cost"><span>{{ t.programs.cost }}</span><em class="cost-value">{{ cost }}</em></p>{% endif %}
{% if cost_plain %}<p class="program-cost is-plain"><span>{{ t.programs.cost }}</span>{{ cost_plain }}</p>{% endif %}
{%- endmacro %}

{# The pen loop drawn around the selected tab; every tab selector shares it. #}
{% macro tab_loop() -%}
<svg class="audience-loop" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M112 7C158 5 197 15 195 32C193 51 136 57 94 56C47 55 5 47 6 29C7 13 49 3 104 5C140 6 170 11 186 20"/></svg>
{%- endmacro %}

{# The scholarship line of an open offer sits under its title, in the slot the
   closed-cohort status uses, with the Monthly tag beside it. #}
{% macro program_scholarship(row) -%}
{% if row.scholarship is defined and row.scholarship %}<span class="program-scholarship"><span>{{ row.scholarship }}</span>{% if row.cost_note is defined %}<small class="cost-note">{{ row.cost_note }}</small>{% endif %}</span>{% endif %}
{%- endmacro %}

{% macro teacher_row(row) -%}
<article class="program-row" id="program-{{ row.id }}" data-program="{{ row.id }}" data-location="{{ row.location }}">
  <h4>{{ row.title_html }}</h4>
  {{ program_scholarship(row) }}
  {{ program_meta(row.where, row.when, row.cost, row.cost_plain | default(none)) }}
  {{ apply_button('button apply-button') }}
</article>
{%- endmacro %}

{# The open program of a pane: its title is the pane heading (`heading` is
   that heading's id). The terms follow straight on the plum: the
   scholarship word (a link down to the scholarship band), then a card of the fields the row
   has (Cost, How often, Next, Where); the Apply stands apart below. #}
{% macro program_offer(row, heading, action=none) -%}
<div class="program-offer">
  <article class="offer-terms" id="program-{{ row.id }}" data-program="{{ row.id }}" aria-labelledby="{{ heading }}">
    {% set scholarship = row.scholarship if row.scholarship is defined else none %}
    {% if scholarship %}<p class="offer-tags"><a class="offer-tag offer-scholarship" href="#scholarship">{{ scholarship }}</a></p>{% endif %}
    <div class="offer-meta">
      {% if row.cost %}<p><span>{{ t.programs.cost }}</span><em class="offer-meta-cost">{{ row.cost }}</em></p>{% endif %}
      {% if row.frequency is defined %}<p><span>{{ row.frequency_label | default(t.programs.frequency) }}</span><em class="offer-meta-frequency">{{ row.frequency }}</em></p>{% endif %}
      {% if row.next is defined %}<p><span>{{ t.programs.next }}</span>{{ row.next }}</p>{% endif %}
      <p><span>{{ t.programs.where }}</span>{{ row.where }}</p>
    </div>
  </article>
  {{ apply_button('button apply-button offer-apply', action) }}
</div>
{%- endmacro %}

{# The first teachers' row is the current open program: its terms sit under
   the fellowship heading (see the pane below), outside the filtered list. The
   location filter lists only the locations left in the list, and shows
   only when there are two or more of them. #}
{% macro programs(audience) -%}
{% if audience == 'teachers' %}
{% set present = t.programs.teachers[1:] | map(attribute='location') | list %}
{% set locations = t.programs.locations | selectattr('value', 'in', present) | list %}
{% else %}
{% set locations = t.programs.locations[:1] %}
{% endif %}
<div class="programs" id="{{ 'programs' if audience == 'teachers' else 'leaders-programs' }}">
  <div class="program-heading">
    <h3>{{ t.programs.running }}</h3>
    {% if locations | length > 1 %}
    {# Same selector as the audience tabs; here the tabs filter the rows. #}
    <div class="audience-tabs program-tabs" role="tablist" aria-label="{{ t.programs.filter_aria }}">
      {% for loc in locations %}
      <button type="button" class="audience-tab" role="tab" id="{{ audience }}-location-{{ loc.value }}" data-value="{{ loc.value }}"
              aria-controls="{{ audience }}-program-list" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>
        <span>{{ loc.label }}</span>
        {{ tab_loop() }}
      </button>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  <div class="program-list" id="{{ audience }}-program-list" aria-live="polite">
    {% if audience == 'leaders' %}
    {# The open row is the pane's offer; the list keeps the rest. #}
    {% for row in t.programs.leaders if row.closed %}
    <article class="program-row" id="program-{{ row.id }}" data-program="{{ row.id }}"{% if row.closed %} data-closed{% endif %}>
      <h4>{{ row.title_html }}</h4>
      {% if row.badge %}<span class="program-badge"><span>{{ row.badge }}</span></span>{% endif %}
      {{ program_scholarship(row) }}
      {% if row.closed %}
      <p class="program-soon">{{ t.programs.results_soon }}</p>
      {% else %}
      {{ program_meta(row.where, row.when, row.cost, row.cost_plain | default(none)) }}
      {{ apply_button('button apply-button', t.programs.join) }}
      {% endif %}
    </article>
    {% endfor %}
    {% else %}
    {% for row in t.programs.teachers[1:] %}
    {{ teacher_row(row) }}
    {% endfor %}
    {% endif %}
  </div>
</div>
{%- endmacro %}
{# An article page brings its own title, copy and labels (build.py, PAGES):
   `a.title`, `a.body()` and the rest come from its file in src/articles/. #}
{% if article %}{% import article as a with context %}{% endif %}
{# The article the landing features: its note's and desk's copy is `f.teaser`. #}
{% if feature %}{% import feature.file as f with context %}{% endif %}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if page == 'schools' %}
  <title>{{ t.partners.title }} · Morim Foundation</title>
  <meta name="description" content="{{ t.partners.lead }}">
  {% elif article %}
  <title>{{ a.title }} · Morim Foundation</title>
  <meta name="description" content="{{ a.description }}">
  {% else %}
  <title>{{ t.meta.title }}</title>
  <meta name="description" content="{{ t.meta.description }}">
  {% endif %}
  {% if article %}
  <meta name="author" content="{{ a.author }}">
  {# A shared link to an article shows its headline chart. PNG, not WebP:
     not every link preview reads WebP; absolute, like canonical. #}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ a.title }}">
  <meta property="og:description" content="{{ a.description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site }}{{ a.share_image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="675">
  <meta property="og:image:alt" content="{{ a.share_alt }}">
  <meta property="og:site_name" content="Morim Foundation">
  <meta property="og:locale" content="{{ t.meta.locale }}">
  <meta name="twitter:card" content="summary_large_image">
  {% else %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ t.meta.og_title }}">
  <meta property="og:description" content="{{ t.meta.description }}">
  <meta property="og:site_name" content="Morim Foundation">
  <meta property="og:locale" content="{{ t.meta.locale }}">
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="theme-color" content="#f4f3f0">
  <link rel="canonical" href="{{ canonical }}">
  {# Absolute by necessity: a relative hreflang is ignored outright. Only the
     translations this page has (an article may exist in one language). #}
  {% for l in langs if l.exists %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ l.url }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ x_default }}">
  <link rel="icon" href="{{ root }}assets/favicon.png">
  {# The faces the first screen sets, requested with the page: the display,
     the body subset the language needs, the wordmark in the header, and
     the pen hand of the notes. All WOFF2 (George, 27.10: fonts arrived
     late and the fallback showed). #}
  {% if lang == 'ru' %}
  <link rel="preload" href="{{ root }}assets/fonts/Spectral-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/Spectral-Light.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/Onest-Variable-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/Onest-Variable-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/Caveat-Regular.woff2" as="font" type="font/woff2" crossorigin>
  {% elif lang == 'he' %}
  <link rel="preload" href="{{ root }}assets/fonts/FrankRuhlLibre-Variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/Heebo-Variable-hebrew.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/Heebo-Variable-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/GveretLevin-Regular.woff2" as="font" type="font/woff2" crossorigin>
  {% else %}
  <link rel="preload" href="{{ root }}assets/fonts/GTAlpina-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/GTAlpina-Light.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/Onest-Variable-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ root }}assets/fonts/Caveat-Regular.woff2" as="font" type="font/woff2" crossorigin>
  {% endif %}
  <link rel="preload" href="{{ root }}assets/fonts/GTAlpina-Medium.woff2" as="font" type="font/woff2" crossorigin>
  {% if modules %}
  {# The module graph behind main.js, one modulepreload each, so the browser
     fetches the scripts in parallel instead of walking the import chain. #}
  {% for m in modules %}
  <link rel="modulepreload" href="{{ root }}js/{{ m }}?v={{ v }}">
  {% endfor %}
  {% endif %}
  {# Same order as the PR's layout.tsx imports: the cascade depends on it. #}
  <link rel="stylesheet" href="{{ root }}css/base.css?v={{ v }}">
  <link rel="stylesheet" href="{{ root }}css/sections.css?v={{ v }}">
  <link rel="stylesheet" href="{{ root }}css/motion.css?v={{ v }}">
  <link rel="stylesheet" href="{{ root }}css/mobile.css?v={{ v }}">
  <link rel="stylesheet" href="{{ root }}css/header.css?v={{ v }}">
  <link rel="stylesheet" href="{{ root }}css/hero.css?v={{ v }}">
  <link rel="stylesheet" href="{{ root }}css/widgets.css?v={{ v }}">
  <link rel="stylesheet" href="{{ root }}css/type.css?v={{ v }}">
  {% if article %}
  <link rel="stylesheet" href="{{ root }}css/article.css?v={{ v }}">
  {% endif %}
  <script src="{{ root }}js/page-slide.js?v={{ v }}"></script>
  {# Without JS the side panels read in place as sections; their openers
     and close buttons have nothing to do. #}
  <noscript><style>.side-panel{position:static;display:block;inline-size:auto;block-size:auto;max-block-size:none;overflow:visible;box-shadow:none;margin-block-start:1rem}.side-panel-close,[data-dialog]{display:none}</style></noscript>
</head>
<body>
<main id="top" data-lang="{{ lang }}">

  <div class="header-shell" data-compact="false">
    {# v4-bar: no menu. The logo sits alone on its white pill; the languages
       float on a pill of their own at the other end. The only call to action
       is Apply on the program bar at the bottom. #}
    <div class="header-start">
      <header class="site-header">
        <a class="logo" href="{{ home }}#top" aria-label="{{ t.header.logo_aria }}">{{ t.header.logo }}</a>
      </header>
      {# A page of its own gets a way back on a pill of its own beside the
         logo: schools to the audiences it was opened from, the featured
         article to its band, another article to the top (build.py, back). #}
      {% if page != 'home' %}
      <a class="back-float" href="{{ home }}{{ back }}">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>{{ t.header.back }}</span>
      </a>
      {% endif %}
    </div>
    <nav class="lang-float" aria-label="{{ t.header.nav_aria }}">
      {{ lang_menu() }}
    </nav>
  </div>

  {% if page == 'schools' %}
  {% include 'schools.html.j2' %}
  {% elif article %}
  {% include 'article.html.j2' %}
  {% else %}
  {# The hero says the claim once and shows why: on the start side the
     headline, the lead and the one Apply above the fold; on the end side
     the years a teacher in Israel has just lived through, as a stack of
     notes, the last one left open. The cards are a list in order, read
     once; nothing here moves or needs a script. #}
  {% set current = t.programs.teachers[0] %}
  <section class="hero hero-years-layout" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">{{ t.hero.title_html }}</h1>
      <p class="hero-lead">{{ t.hero.lead }}</p>
      <p class="hero-actions">
        {{ apply_button('button hero-apply') }}
        <span class="hero-next">{{ t.hero.next_label }} {{ current.next }} · <a href="#scholarship">{{ t.hero.next_terms }}</a></span>
      </p>
    </div>
    <ol class="hero-years" aria-label="{{ t.hero.years_aria }}">
      {% for y in t.hero.years %}
      <li class="hero-year" data-tint="{{ y.tint }}"><span class="hero-year-when"><bdi>{{ y.when }}</bdi></span><span class="hero-year-text">{{ y.text }}</span></li>
      {% endfor %}
      <li class="hero-year hero-year-next"><span class="hero-year-when">{{ t.hero.next_year }}</span><span class="hero-year-text">{{ t.hero.next_year_text }}</span></li>
    </ol>
  </section>
  {# A small fixed hint at the bottom of the first screen; js/scroll-hint.js
     hides it after the second scroll gesture, or at once if the page did not
     open at the top. #}
  <a class="scroll-hint" href="#what-we-do" data-scroll-hint>
    <span>{{ t.hero.scroll_hint }}</span>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </a>
  {# The floating Apply: js/lib/floating-apply.js shows it once the hero has
     scrolled off and no Apply (hero, offers, footer) is in view. Not a
     [data-apply] itself, or it would hide on its own appearance. #}
  <div class="floating-apply-rail" data-anchor=".hero" inert>
    <a class="button floating-apply-button" href="{{ t.links.survey }}">{{ t.programs.apply }}</a>
  </div>

  {# What the programs stand on, in three lines and three rows: what the
     job is for (it stays), what the classroom is up against now (it
     changes), and adapting as a practised habit. The featured article's
     pen note hangs over the first row and points at the word it is about;
     js/margin-note.js draws its arrow. Phones: the note drops under the
     row's text, no arrow. #}
  <section class="stance" id="what-we-do" aria-labelledby="what-we-do-title">
    <div class="stance-head">
      <h2 class="display" id="what-we-do-title">{{ t.what_we_do.title_html }}</h2>
      <p class="stance-lead">{{ t.what_we_do.lead }}</p>
    </div>
    <div class="stance-rows">
      {% for row in t.what_we_do.stance %}
      <div class="stance-row">
        <p class="stance-label">{{ row.label }}</p>
        <h3 class="stance-title">{{ row.title_html }}</h3>
        <p class="stance-body">{{ row.body }}</p>
        {% if feature and loop.first %}
        <a class="margin-note" href="{{ feature.href }}" data-claim=".stance-title mark" data-arrow="down">{{ f.teaser.margin_html }}</a><svg class="margin-note-arrow" aria-hidden="true" focusable="false"><path d=""/></svg>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>

  {# This year's two themes on the paper, and a third card left empty on
     purpose: the list is dated, and it will change. The icons are the ones
     the children's phones carry; decoration, so empty alt. Their box is
     2.75rem, which above 701px is 3.05vw (see the photo macro on `sizes`). #}
  {% set year = t.what_we_do.year %}
  {% set theme_icons = [['tiktok', 'youtube', 'instagram', 'discord'], ['chatgpt']] %}
  <section class="year" id="this-year" aria-labelledby="year-title">
    <p class="year-kicker">{{ year.kicker }}</p>
    <h2 class="year-title" id="year-title">{{ year.title }}</h2>
    <div class="year-cards">
      {% for theme in year.themes %}
      <article class="year-card">
        <p class="year-icons" aria-hidden="true">{% for slug in theme_icons[loop.index0] %}<img src="{{ root }}assets/hero-app-{{ slug }}-128.webp" srcset="{{ root }}assets/hero-app-{{ slug }}-128.webp 128w, {{ root }}assets/hero-app-{{ slug }}-256.webp 256w" sizes="(max-width: 700px) 2.5rem, 3.05vw" alt="" width="128" height="128" loading="lazy" decoding="async">{% endfor %}</p>
        <h3>{{ theme.title }}</h3>
        <p>{{ theme.body }}</p>
      </article>
      {% endfor %}
      <article class="year-card year-card-next">
        <h3>{{ year.next_title }}</h3>
        <p class="year-next-note">{{ year.next_note }}</p>
      </article>
    </div>
  </section>

  {# The program as a sequence (Vlad, 23.10): four steps in order, the number
     in the handwritten hand; the theses ("more than half of the program",
     "every week, in a small group") sit inside the body as <mark> with the
     marker stroke (George, 23.10). The pen line under the steps says what
     holds still while the year's themes change. #}
  <section class="how" id="how-it-works" aria-labelledby="how-title">
    <div class="wwd-steps">
      <h2 class="how-title" id="how-title">{{ t.what_we_do.how_it_works.heading }}</h2>
      <ol class="wwd-steps-list">
        {% for s in t.what_we_do.how_it_works.steps %}
        <li class="wwd-step">
          <span class="wwd-step-num" aria-hidden="true">{{ loop.index }}</span>
          <h4>{{ s.title }}</h4>
          <p>{{ s.body_html }}</p>
        </li>
        {% endfor %}
      </ol>
      <div class="prose wwd-steps-close">
        <p class="beat-note wwd-note">{{ t.what_we_do.practice_note }}</p>
        <p>{{ t.what_we_do.how_it_works.note }}</p>
      </div>
    </div>
  </section>

  {# The Tbilisi camp, the pilot of the teachers' program: its own peach
     section before the offers, so the proof comes ahead of the ask. Copy
     and the survey figures on the start side, the photo on the end side
     (above the copy on mobile); the adapting figure leads, because that is
     what the program is for. The teacher's line and the caveat sit under
     both, always open.
     Photo: session-photos/Day2 (Kids)/R0016143.JPG, the camp's children's
     day (12 Aug 2026), centre square crop: a child over the alphabet
     sheet. #}
  {% set tb = t.programs.tbilisi %}
  <section class="camp" id="tbilisi-camp" aria-labelledby="tbilisi-promo-title" data-program="{{ tb.id }}">
    <div class="camp-copy">
      <h2 id="tbilisi-promo-title">{{ tb.title_html }}</h2>
      <p class="promo-meta"><span>{{ tb.where }}</span><span><bdi dir="ltr">{{ tb.dates }}</bdi></span><span>{{ tb.finished }}</span></p>
      <p class="camp-intro">{{ tb.intro }}</p>
      <ul class="camp-figures" role="list">
        {% for s in tb.stats %}
        <li class="camp-figure">
          <span class="stat-value">{{ s.value_html }}</span>
          <span class="stat-label">{{ s.label }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
    {{ photo('camp-photo', 'camp-square', [480, 720, 1080, 1440], '(max-width: 700px) 16rem, 26rem', '', 720, 720) }}
    <div class="camp-details">
      <div class="camp-story">
        <figure class="camp-voice">
          <blockquote class="results-quote">{{ tb.quote }}</blockquote>
          <figcaption class="results-note">{{ tb.quote_note }}</figcaption>
        </figure>
        <p class="results-caveat">{{ tb.caveat }}</p>
      </div>
    </div>
  </section>

  {# Teachers, coordinators, schools: one panel, one audience at a time. The
     selector sits over the heading and draws a loop around the active word;
     without JS all three panes stay visible in order and the tabs are anchors. #}
  <div class="story-stack">
    <section class="audiences" id="audiences" aria-label="{{ t.what_we_do.routes.aria }}">
    {# Schools and partners have a page of their own: the link sits after
       the tablist with an arrow. #}
    <div class="audience-nav">
    <div class="audience-tabs" role="tablist" aria-label="{{ t.what_we_do.routes.aria }}">
      {% for key, pane in [('teachers', 'fellowship'), ('coordinators', 'leaders')] %}
      <a class="audience-tab" role="tab" id="tab-{{ pane }}" href="#{{ pane }}" aria-controls="{{ pane }}"
         aria-selected="{{ 'true' if loop.first else 'false' }}">
        <span>{{ t.what_we_do.routes[key] }}</span>
        {{ tab_loop() }}
      </a>
      {% endfor %}
    </div>
    <a class="audience-trigger text-link" href="schools/">
      <span>{{ t.what_we_do.routes.schools }}</span><svg class="promo-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
    </div>
    <div class="audience-pane fellowship" id="fellowship" role="tabpanel" aria-labelledby="fellowship-title">
      {# The pane is the offer of the open monthly program: its title is the
         heading, under the fellowship's own name and the edition (inside
         the heading, so the two stay together when js/audiences.js evens
         the panes' headings); its terms and a standalone Apply follow,
         then "Dear teachers" opens the intro. #}
      {% set current = t.programs.teachers[0] %}
      <h2 class="display" id="fellowship-title"><span class="offer-kicker">{{ current.kicker }}</span> {{ current.title_html }}</h2>
      {{ program_offer(current, 'fellowship-title', t.programs.apply_now) }}
      <div class="prose fellowship-intro">
        {% for p in t.fellowship.intro %}
        <p>{% if loop.first %}{{ t.fellowship.title_html | striptags }} {% endif %}{{ p }}</p>
        {% endfor %}
      </div>
      {# What the intensives work on this year, as questions in the scribble
         hand; the list changes with the year's themes. #}
      <div class="prose fellowship-practice">
        <p class="questions-title">{{ t.fellowship.questions_title }}</p>
        <div class="questions" aria-label="{{ t.fellowship.questions_aria }}">
          {% for q in t.fellowship.questions %}
          <span>{{ q }}</span>
          {% endfor %}
        </div>
      </div>
      {% if t.programs.teachers | length > 1 %}{{ programs('teachers') }}{% endif %}
    </div>

    <div class="audience-pane leaders" id="leaders" role="tabpanel" aria-labelledby="leaders-title">
      {# The same offer as the fellowship pane: the open coordinators' program
         is the heading, its terms and Apply follow, then the running cohort,
         then "Dear coordinators" opens the intro in the scribble hand. #}
      {% set open_leaders = t.programs.leaders | rejectattr('closed') | first %}
      <h2 class="display" id="leaders-title">{{ open_leaders.title_html }}</h2>
      {{ program_offer(open_leaders, 'leaders-title', t.programs.apply_now) }}
      {# The closed cohort under the Apply, as wide as the intro. The program
         name is the pane heading just above, so the card names only its state. #}
      {% for row in t.programs.leaders if row.closed %}
      <article class="running-card" id="program-{{ row.id }}" data-closed>
        <h3>{{ t.programs.pilot_title }}</h3>
        <p class="running-status">{{ t.programs.results_soon }}</p>
        <p class="running-badge running-now">{{ t.programs.running }}</p>
      </article>
      {% endfor %}
      <div class="prose leaders-intro">
        {% for p in t.leaders.intro %}
        <p>{% if loop.first %}{{ t.leaders.title_html | striptags }} {% endif %}{{ p }}</p>
        {% endfor %}
      </div>
      <div class="leader-benefits feature-cards">
        {% for b in t.leaders.benefits %}
        <article class="benefit">
          <h3>{{ b.title }}</h3>
          <p>{{ b.body }}</p>
        </article>
        {% endfor %}
      </div>
    </div>

    </section>
  </div>

  {# The scholarship: a blue band of its own right after the audiences; the
     scholarship word in either offer links here. The pen word is the band's
     one heading, large, then the fellowship feature's two sentences (the
     second set apart as the reason) and a row of terms.
     The terms are placeholders pending Vlad: only "Monthly" comes from the
     offers; who, how, what it asks and the amount are invented. #}
  <section class="scholarship-band" id="scholarship" aria-labelledby="scholarship-title">
    <h2 class="scholarship-word" id="scholarship-title">{{ t.scholarship.title }}</h2>
    <div class="scholarship-text">
      {% for p in t.scholarship.body %}
      <p>{{ p }}</p>
      {% endfor %}
    </div>
    <dl class="scholarship-terms">
      {% for term in t.scholarship.terms %}
      <div><dt>{{ term.label }}</dt><dd>{{ term.value }}</dd></div>
      {% endfor %}
    </dl>
  </section>

  {# The featured article on a researcher's desk, before the people: the
     story runs problem, programs, pilot, then who reads the data. Copy on
     the start side; the desk on the end side, bleeding off the page, with
     the article as a printed page (a second way into it), a page behind
     it, a sticky, a clip and a pencil. The scene is drawn in em, so one
     font-size scales it; it is hidden from assistive tech, whose way in is
     the copy's link. #}
  {% if feature %}
  {% set desk = f.teaser.desk %}
  <section class="desk" id="{{ feature_id }}" aria-labelledby="{{ feature_id }}-title">
    <div class="desk-copy">
      <p class="desk-kicker">{{ desk.kicker }}</p>
      <h2 class="desk-title" id="{{ feature_id }}-title">{{ desk.title_html }}</h2>
      <p class="desk-text">{{ desk.text }}</p>
      <a class="text-link desk-link" href="{{ feature.href }}"><span>{{ desk.link }}</span><svg class="promo-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <div class="desk-scene" aria-hidden="true">
      <div class="desk-sheet desk-sheet-back">
        <img src="{{ root }}assets/articles/{{ desk.back_chart }}-720.webp" srcset="{% for w in [480, 720, 1080] %}{{ root }}assets/articles/{{ desk.back_chart }}-{{ w }}.webp {{ w }}w{{ ", " if not loop.last }}{% endfor %}" sizes="(max-width: 700px) 42vw, 23vw" alt="" width="1920" height="1080" loading="lazy" decoding="async">
        <p>{{ desk.back_text }}</p>
      </div>
      <a class="desk-sheet desk-sheet-front" href="{{ feature.href }}" tabindex="-1">
        <span class="sheet-head"><span class="sheet-brand">{{ t.header.logo }}</span><span>{{ desk.page_kicker }}</span></span>
        <span class="sheet-title">{{ f.title_html }}</span>
        <span class="sheet-dek">{{ f.dek }}</span>
        <img src="{{ root }}assets/articles/{{ desk.page_chart }}-720.webp" srcset="{% for w in [480, 720, 1080] %}{{ root }}assets/articles/{{ desk.page_chart }}-{{ w }}.webp {{ w }}w{{ ", " if not loop.last }}{% endfor %}" sizes="(max-width: 700px) 50vw, 28vw" alt="" width="1920" height="1080" loading="lazy" decoding="async">
        <span class="sheet-text">{{ desk.page_text }}</span>
        <span class="sheet-note">{{ desk.page_note }}</span>
      </a>
      <svg class="desk-clip" viewBox="0 0 40 96" focusable="false"><path d="M14 74V18C14 10 26 10 26 18V80C26 92 6 92 6 80V24M20 70V26"/></svg>
      <p class="desk-sticky"><span>{{ desk.sticky }}</span></p>
      <svg class="desk-pencil" viewBox="0 0 330 40" focusable="false"><rect class="pencil-body" x="34" y="10" width="250" height="20" rx="2"/><rect class="pencil-shine" x="34" y="10" width="250" height="6"/><rect class="pencil-band" x="284" y="10" width="16" height="20"/><rect class="pencil-eraser" x="300" y="10" width="26" height="20" rx="5"/><path class="pencil-wood" d="M34 10 4 20l30 10Z"/><path class="pencil-lead" d="m12 17-8 3 8 3Z"/></svg>
    </div>
  </section>
  {% endif %}

  <section class="team" id="team" aria-labelledby="team-title">
    <p class="eyebrow">{{ t.team.eyebrow }}</p>
    <h2 class="team-title" id="team-title">{{ t.team.title_html }}</h2>
    <div class="team-columns">
      {% for p in t.team.people %}
      <article class="person">
        {% if p.photo %}
        <img class="portrait" src="{{ root }}assets/{{ p.photo }}" alt="{{ p.name }}" width="420" height="510" loading="lazy">
        {% else %}
        <div class="portrait-placeholder" role="img" aria-label="{{ t.team.portrait_pending.replace('{name}', p.name) }}"></div>
        {% endif %}
        <h3>{% if p.href %}<a href="{{ p.href }}" target="_blank" rel="noreferrer">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</h3>
        <p class="person-role">{{ p.role }}</p>
        <p>{{ p.bio_html }}</p>
      </article>
      {% endfor %}
    </div>
    <div class="team-note">
      <h3>{{ t.team.note.title }}</h3>
      <p>{{ t.team.note.body }}</p>
    </div>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">{{ t.faq.title }}</h2>
    <div class="faq-list">
      {% for item in t.faq.questions %}
      <details class="faq-item" data-state="closed">
        <summary class="faq-trigger">
          {{ item.q }}
          <svg class="faq-chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="faq-answer">
          <div class="faq-answer-body">{{ item.a }}</div>
        </div>
      </details>
      {% endfor %}
    </div>
  </section>

  {% endif %}

  <footer id="contact" class="site-footer">
    <div class="footer-message">
      <h2>{{ t.footer.title }}</h2>
      <p class="footer-lead">{{ t.footer.lead_before }}<a href="{{ t.links.survey }}">{{ t.footer.lead_link }}</a>{{ t.footer.lead_after }}</p>
      {# Apply is the landing's action; the address is the one way to write,
         on both pages (partners have their own button above). #}
      {% if page != 'schools' %}
      <p class="footer-actions">{{ apply_button('button footer-apply') }}</p>
      {% endif %}
      <a class="footer-email" href="{{ t.links.email }}">{{ t.footer.email }}</a>
    </div>
    <div class="footer-links">
      <div>
        <p class="footer-label">{{ t.footer.foundation_label }}</p>
        <nav aria-label="{{ t.footer.nav_aria }}">
          {% for item in t.nav %}
          <a href="{{ home }}{{ item.href if item.href is defined else '#' ~ item.id }}">{{ item.label }}</a>
          {% endfor %}
        </nav>
      </div>
      <div>
        <p class="footer-label">{{ t.footer.socials_label }}</p>
        <nav aria-label="{{ t.footer.socials_aria }}">
          {% for name in t.footer.socials %}
          <button type="button" class="text-button" data-dialog="dialog-social" data-dialog-title="{{ name }}">{{ name }}</button>
          {% endfor %}
        </nav>
      </div>
      <div>
        <p class="footer-label" aria-hidden="true">{{ t.switcher.label }}</p>
        {{ switcher('lang-switcher-footer') }}
      </div>
    </div>
    <div class="footer-legal">
      <a class="logo" href="{{ home }}#top" aria-label="{{ t.header.logo_aria }}">{{ t.header.logo }}</a>
      <p>{{ t.footer.legal_html }}</p>
    </div>
  </footer>
</main>

{# Modal content lives outside <main> so the page can be inert while it is open. #}
<dialog class="morim-dialog" id="dialog-social" aria-labelledby="dialog-social-title" aria-describedby="dialog-social-desc">
  <div class="morim-dialog-body">
    <h2 id="dialog-social-title" data-dialog-title></h2>
    <p id="dialog-social-desc">{{ t.dialogs.social.body }}</p>
    <button type="button" class="dialog-close" data-dialog-close aria-label="{{ t.dialogs.close }}">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
</dialog>


<script type="module" src="{{ root }}js/main.js?v={{ v }}"></script>
</body>
</html>
